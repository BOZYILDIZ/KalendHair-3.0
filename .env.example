# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ─── Auth (NextAuth v5) ────────────────────────────────────────────────────────
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Google OAuth (optionnel)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Cache (Upstash Redis) ────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── Emails (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
EMAIL_FROM=noreply@kalendhair.fr

# ─── Paiements (Stripe) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Plans Stripe (IDs à créer dans le dashboard Stripe)
STRIPE_PRICE_PRO_MONTHLY=price_xxxx
STRIPE_PRICE_BUSINESS_MONTHLY=price_xxxx

# ─── Jobs background (Trigger.dev) ────────────────────────────────────────────
TRIGGER_SECRET_KEY=tr_dev_xxxx
NEXT_PUBLIC_TRIGGER_PUBLIC_API_KEY=pk_dev_xxxx

# ─── Connecteurs (remplis par le salon dans les paramètres) ──────────────────
# Ces clés sont stockées chiffrées en DB — ne pas mettre ici en prod
CONNECTOR_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Webhook secrets (pour vérifier les webhooks entrants)
SILAE_WEBHOOK_SECRET=
PENNYLANE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxx@sentry.io/xxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
